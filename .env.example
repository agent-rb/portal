# ── Chat mode ────────────────────────────────────────────
# "chat"  — Simple chat. Model + system prompt. No RAG, no tools. (default)
# "llm"   — Model + portal-provided RAG, tools, and system prompt.
# "agent" — Thin proxy to an external agent harness.
CHAT_MODE=chat

# ── Backend ──────────────────────────────────────────────
# In LLM mode:  this is the model endpoint (OpenAI-compatible).
# In agent mode: this is the agent harness endpoint.

AGENT_BASE_URL=https://text.pollinations.ai/v1
AGENT_API_KEY=anonymous
AGENT_MODEL=openai
# AGENT_TIMEOUT_MS=30000

# Show model reasoning/thinking tokens in the chat (default: false).
# Set to "true" to see the model's thinking process.
# SHOW_REASONING=false

# LLM mode examples:
#   Groq          AGENT_BASE_URL=https://api.groq.com/openai/v1  AGENT_API_KEY=gsk_…  AGENT_MODEL=llama-3.3-70b-versatile
#   Ollama        AGENT_BASE_URL=http://localhost:11434/v1  AGENT_API_KEY=ollama  AGENT_MODEL=hermes3
#   OpenAI        AGENT_BASE_URL=https://api.openai.com/v1  AGENT_API_KEY=sk-…   AGENT_MODEL=gpt-4o-mini

# Agent mode examples:
#   CHAT_MODE=agent
#   AGENT_BASE_URL=https://my-agent.railway.app/v1
#   AGENT_API_KEY=secret-token
#   AGENT_MODEL=default

# ── Storage ─────────────────────────────────────────────
# Local filesystem (container / npm). Not used on Vercel.
# DATA_DIR=.data

# Webhook URLs for serverless deployments (Vercel, Netlify, etc.).
# When set, the subscribe and question tools POST to these URLs
# instead of writing to the local filesystem.
# SUBSCRIBE_WEBHOOK_URL=https://api.buttondown.email/v1/subscribers
# SUBSCRIBE_WEBHOOK_SECRET=your-api-token
# QUESTION_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# QUESTION_WEBHOOK_SECRET=your-api-token

# ── Rate limiting ───────────────────────────────────────
# Override the defaults from src/config/agents.ts.
# AGENT_RATE_LIMIT_MAX=20
# AGENT_RATE_LIMIT_WINDOW_MS=60000
